.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# TypeScript build info cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea
.vscode
*.swp
*.swo

# Local environment files (commit templates only)
.env.*
!.env.example

# Runtime logs and test artifacts
*.log
*.log.*
/test-results/
/playwright-report/
/coverage/

