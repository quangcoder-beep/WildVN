# Copy to docker-compose.env; keep credentials out of version control (chmod 600).
# Start dependencies: ./docker-compose --env-file docker-compose.env up -d
# Start existing MinIO separately: docker start minio
# Existing MinIO credentials and volume minio_data stay on that container.
# PostgreSQL on the host remains the default; container requires --profile database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=wildvn
