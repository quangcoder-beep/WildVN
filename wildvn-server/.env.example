# Copy to an untracked local environment file or configure these values in your runtime.
# Never commit real credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-a-rotated-password

# Required for login/token signing; generate locally, never commit the value.
JWT_SECRET=
CSRF_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Chat runs from PostgreSQL without a paid provider. Supplying a Claude key
# later automatically switches CHAT_PROVIDER=auto to Anthropic after restart.
CHAT_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_ENDPOINT=https://api.anthropic.com
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_MAX_MESSAGES=20
CHAT_CLEANUP_CRON=0 0 * * * *

# Set MINIO_ENABLED=true only after supplying fresh MinIO credentials. The
# endpoint must be reachable by the browser when the API returns presigned URLs.
MINIO_ENABLED=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=wildvn
MINIO_PRESIGNED_URL_TTL_SECONDS=900

# Only set these when OAuth login is enabled.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_SECRET=
