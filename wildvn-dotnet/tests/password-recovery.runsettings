<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[WildVN.Application]WildVN.Application.Auth.PasswordRecovery*,[WildVN.Infrastructure]WildVN.Infrastructure.Auth.PostgresPasswordRecoveryStore*,[WildVN.Infrastructure]WildVN.Infrastructure.Auth.ResetMail*,[WildVN.Infrastructure]WildVN.Infrastructure.Auth.SmtpResetMail*,[WildVN.Infrastructure]WildVN.Infrastructure.Auth.LegacyJwtTokens*,[WildVN.Infrastructure]WildVN.Infrastructure.Auth.PostgresAuthStore*,[WildVN.Api]WildVN.Api.Auth.PasswordRecovery*,[WildVN.Api]WildVN.Api.Auth.ResetMailWorker*,[WildVN.Api]WildVN.Api.Auth.LegacyCookieHandler*</Include>
          <SingleHit>false</SingleHit>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
