<UserControl x:Class="WildVN.Desktop.Media.MediaPoCView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="PoC media — dữ liệu cục bộ" FontSize="26" FontWeight="SemiBold"/>
   <TextBlock Text="Ảnh / video / âm thanh cùng mẫu. Windows codec và số đo chưa kiểm chứng." TextWrapping="Wrap"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,12">
   <Button Content="WPF native" Click="Native_Click"/>
   <Button Content="WebView2 cục bộ" Click="Web_Click"/>
   <Button Content="Phát" Tag="Play" Click="Playback_Click"/>
   <Button Content="Tạm dừng" Tag="Pause" Click="Playback_Click"/>
   <Button Content="Dừng" Tag="Stop" Click="Playback_Click"/>
   <CheckBox x:Name="MutedToggle" Content="Tắt tiếng" IsChecked="True" Margin="8" Click="Mute_Click"/>
   <CheckBox x:Name="MotionToggle" Content="Giảm chuyển động" IsChecked="True" Margin="8" Click="Motion_Click"/>
   <Button Content="Đọc số đo WebView2" Click="Metrics_Click"/>
  </WrapPanel>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ContentControl x:Name="PresenterHost"/></ScrollViewer>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="Chọn file mẫu bằng cấu hình trước khi chạy." TextWrapping="Wrap" AutomationProperties.AutomationId="MediaReadyStatus" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</UserControl>
