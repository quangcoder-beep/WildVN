<Window x:Class="WildVN.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WildVN.Desktop"
        Title="WildVN .NET — P0" Width="1040" Height="700" MinWidth="760" MinHeight="520"
        FontFamily="Segoe UI" FontSize="15">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="NavigationPanel">
            <TextBlock Text="WildVN" FontWeight="Bold" FontSize="26" Margin="0,0,0,20" />
            <Button Content="Danh mục loài" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:ShellSection.Catalog}" />
            <Button Content="Hệ sinh thái" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:ShellSection.Ecosystems}" />
            <Button Content="Yêu thích" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:ShellSection.Favorites}" />
            <Button Content="Học viện" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:ShellSection.Academy}" />
            <Button Content="Trò chuyện" Command="{Binding NavigateCommand}" CommandParameter="{x:Static local:ShellSection.Chat}" />
            <Separator Margin="0,12" />
            <Button Content="Kiểm tra kết nối API" Command="{Binding CheckConnectionCommand}" />
            <Button Content="Hủy kiểm tra" Command="{Binding CancelConnectionCommand}" />
            <TextBlock Text="{Binding ConnectionMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <ContentControl x:Name="PageContent" Grid.Column="2">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />
                <TextBlock Text="{Binding FeatureStatus}" TextWrapping="Wrap" Margin="0,0,0,20" />
                <TextBlock Text="Bản P0 kiểm chứng nền tảng desktop. Chưa có dữ liệu loài, xác thực hoặc các luồng nghiệp vụ trên giao diện .NET. Kiểm tra kết nối chỉ chạy khi bạn bấm nút."
                           TextWrapping="Wrap" />
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>
